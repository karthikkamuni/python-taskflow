# Copy to .env and adjust. Every value below has a working default, so the
# app also runs with no .env at all.

# ---- backend (port 8000) ----
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./taskflow.db
# PostgreSQL (use this once you have a database container):
# DATABASE_URL=postgresql+psycopg2://taskflow:taskflow@db:5432/taskflow
# Leave empty to disable caching:
REDIS_URL=
# REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=30
NOTIFICATION_SERVICE_URL=http://localhost:8001
DB_CONNECT_RETRIES=15
DB_CONNECT_DELAY_SECONDS=2

# ---- notification-service (port 8001) ----
# Leave empty to keep notifications in memory:
# REDIS_URL=redis://redis:6379/1

# ---- report-service (port 8002) ----
BACKEND_URL=http://localhost:8000

# ---- frontend (port 3000) ----
# BACKEND_URL=http://localhost:8000
NOTIFICATION_URL=http://localhost:8001
REPORT_URL=http://localhost:8002
